{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "permissions": {
    "allow": [
      "Write",
      "Bash(python ~/.config/claude-code/skills/redmine-api/parse_issue.py:*)",
      "Bash(dotnet ~/.config/claude-code/skills/review-mr/extract-redmine-issue.cs:*)",
      "Bash(python3 .claude/skills/summarize-visit-reports/fetch_reports.py:*)",
      "Bash(python3 .claude/skills/summarize-visit-reports/show_overview.py:*)",
      "Bash(python3 .claude/skills/summarize-visit-reports/extract_day_data.py:*)",
      "Bash(python3 .claude/skills/summarize-visit-reports/extract_message_ids.py:*)",
      "Bash(mo :*)",
      "mcp__pencil"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node -e \"import(require('url').pathToFileURL(require('path').join(require('os').homedir(),'.bin','claude-statusline.mjs')).href)\"",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/claude-code/hooks/git-lock-guard.sh"
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "voiceEnabled": true
}
