{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ECC_DISABLED_HOOKS": "pre:bash:gateguard-fact-force"
  },
  "permissions": {
    "allow": [
      "Write",
      "Write(/tmp/*)",
      "WebSearch",
      "Skill(build)",
      "Bash(bash ~/.claude/skills/*/*.sh:*)",
      "Bash(bash ~/.claude/skills/storage-cleanup/scripts/*.sh:*)",
      "PowerShell(pwsh -NoProfile -File ~/.claude/skills/storage-cleanup/scripts/*.ps1:*)",
      "Bash(node ~/.claude/skills/*/*.js:*)",
      "Bash(python3 ~/.claude/skills/*/*.py:*)",
      "Bash(dotnet script ~/.claude/skills/*/*.cs:*)",
      "Bash(bun:*)",
      "Bash(cat:*)",
      "Bash(curl:*)",
      "Bash(difit:*)",
      "Bash(dotnet:*)",
      "Bash(du:*)",
      "Bash(duckdb:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(git:*)",
      "Bash(glab:*)",
      "Bash(gws:*)",
      "Bash(head:*)",
      "Bash(iconv:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(mise:*)",
      "Bash(mo:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(printf:*)",
      "Bash(python3:*)",
      "Bash(rg:*)",
      "Bash(test:*)",
      "Bash(wc:*)",
      "Bash(yes:*)",
      "Bash(zv:*)",
      "Bash(/mnt/c/Windows/System32/clip.exe:*)",
      "mcp__docbase__getPost",
      "mcp__docbaseMcp__*",
      "mcp__redmine__*",
      "mcp__redmineMcp__*",
      "mcp__teamspiritMcp__*",
      "mcp__claude_ai_GitLab__*",
      "mcp__claude_ai_Slack__*",
      "mcp__plugin_playwright_playwright__*",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__*",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.sentry.io)",
      "WebFetch(domain:docs.slack.dev)",
      "WebFetch(domain:blog.sentry.io)",
      "WebFetch(domain:e-seikatsu.docbase.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:help.zoho.com)",
      "WebFetch(domain:project-monitor.es-dev.jp)",
      "WebFetch(domain:qiita.com)",
      "WebFetch(domain:redmine.jp)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:www.redmine.org)",
      "WebFetch(domain:www.splunk.com)",
      "WebFetch(domain:www.zoho.com)",
      "WebFetch(domain:zenn.dev)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-4-6[1M]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/claude-code/hooks/git-lock-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/claude-code/hooks/docbase-edit-guard.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node -e \"import(require('url').pathToFileURL(require('path').join(require('os').homedir(),'.bin','claude-statusline.mjs')).href)\"",
    "padding": 0
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "csharp-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "sentry@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "auth0@claude-plugins-official": false,
    "duckdb-skills@claude-plugins-official": false,
    "desktop-commander@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false,
    "context7@claude-plugins-official": false
  },
  "deniedMcpServers": [
    { "serverName": "claude.ai Adobe for creativity" },
    { "serverName": "claude.ai AWS Knowledge" },
    { "serverName": "claude.ai Figma" },
    { "serverName": "claude.ai Gmail" },
    { "serverName": "claude.ai Google Cloud Developer Knowledge" },
    { "serverName": "claude.ai Google Drive" },
    { "serverName": "claude.ai Microsoft Learn" },
    { "serverName": "claude.ai Zoho Analytics" },
    { "serverName": "claude.ai Zoho CRM" },
    { "serverName": "claude.ai Zoho Desk" },
    { "serverName": "claude.ai Zoho Sprints" },
    { "serverName": "claude.ai ZohoDesk Articles" },
    { "serverName": "claude.ai ZohoProjects Custom" },
    { "serverName": "claude.ai Zoom for Claude" },
    { "serverName": "claude.ai Zuora Billing" }
  ],
  "extraKnownMarketplaces": {},
  "language": "japanese",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
