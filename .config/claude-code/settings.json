{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Write",
      "Write(/tmp/*)",
      "WebSearch",
      "Skill(build)",
      "Bash(bash ~/.claude/skills/*/*.sh:*)",
      "Bash(node ~/.claude/skills/*/*.js:*)",
      "Bash(python3 ~/.claude/skills/*/*.py:*)",
      "Bash(dotnet script ~/.claude/skills/*/*.cs:*)",
      "Bash(bun:*)",
      "Bash(cat:*)",
      "Bash(curl:*)",
      "Bash(difit:*)",
      "Bash(dotnet:*)",
      "Bash(du:*)",
      "Bash(duckdb:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(git:*)",
      "Bash(glab:*)",
      "Bash(gws:*)",
      "Bash(head:*)",
      "Bash(iconv:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(mise:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(printf:*)",
      "Bash(python3:*)",
      "Bash(rg:*)",
      "Bash(test:*)",
      "Bash(wc:*)",
      "Bash(yes:*)",
      "Bash(zv:*)",
      "Bash(/mnt/c/Windows/System32/clip.exe:*)",
      "mcp__docbase__getPost",
      "mcp__docbaseMcp__*",
      "mcp__redmine__get*",
      "mcp__redmine__search",
      "mcp__redmine__updateIssue",
      "mcp__redmine__createIssue",
      "mcp__redmine__*Attachment*",
      "mcp__redmineMcp__*",
      "mcp__teamspiritMcp__*",
      "mcp__plugin_gitlab_gitlab__get_*",
      "mcp__claude_ai_gitlab__*",
      "mcp__claude_ai_Slack__slack_*",
      "mcp__plugin_playwright_playwright__*",
      "mcp__chrome-devtools__*",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.sentry.io)",
      "WebFetch(domain:docs.slack.dev)",
      "WebFetch(domain:blog.sentry.io)",
      "WebFetch(domain:e-seikatsu.docbase.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:help.zoho.com)",
      "WebFetch(domain:project-monitor.es-dev.jp)",
      "WebFetch(domain:qiita.com)",
      "WebFetch(domain:redmine.jp)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:www.redmine.org)",
      "WebFetch(domain:www.splunk.com)",
      "WebFetch(domain:www.zoho.com)",
      "WebFetch(domain:zenn.dev)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/claude-code/hooks/git-lock-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/claude-code/hooks/docbase-edit-guard.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node -e \"import(require('url').pathToFileURL(require('path').join(require('os').homedir(),'.bin','claude-statusline.mjs')).href)\"",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "tsumiki@tsumiki": true,
    "claude-code-setup@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "tsumiki": {
      "source": {
        "source": "git",
        "url": "https://github.com/classmethod/tsumiki.git"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "language": "japanese",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "voiceEnabled": true,
  "skipAutoPermissionPrompt": true
}
