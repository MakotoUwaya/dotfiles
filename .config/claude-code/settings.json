{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Write",
      "WebSearch",
      "Skill(build)",
      "Bash(dotnet ~/.config/claude-code/skills/:*)",
      "Bash(dotnet .claude/skills/:*)",
      "Bash(mo :*)",
      "Bash(git:*)",
      "Bash(glab:*)",
      "Bash(jq:*)",
      "Bash(echo:*)",
      "Bash(node ~/.config/claude-code/:*)",
      "Bash(node .claude/:*)",
      "mcp__pencil",
      "mcp__docbase__getPost",
      "mcp__redmine__get*",
      "mcp__redmine__search",
      "mcp__redmine__updateIssue",
      "mcp__redmine__createIssue",
      "mcp__redmine__*Attachment*",
      "mcp__plugin_gitlab_gitlab__get_*",
      "mcp__claude_ai_gitlab__get_*",
      "mcp__claude_ai_Slack__slack_*",
      "WebFetch(domain:redmine.jp)",
      "WebFetch(domain:github.com)"
    ],
    "defaultMode": "dontAsk"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/claude-code/hooks/git-lock-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/claude-code/hooks/docbase-edit-guard.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node -e \"import(require('url').pathToFileURL(require('path').join(require('os').homedir(),'.bin','claude-statusline.mjs')).href)\"",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "tsumiki@tsumiki": true,
    "claude-code-setup@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "tsumiki": {
      "source": {
        "source": "git",
        "url": "https://github.com/classmethod/tsumiki.git"
      }
    }
  },
  "language": "japanese",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "voiceEnabled": true
}
